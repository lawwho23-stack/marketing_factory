    "owner:password": "node scripts/owner-password.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/noto-sans-myanmar": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",

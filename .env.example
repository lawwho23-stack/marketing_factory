# Web service (never use NEXT_PUBLIC_ for secrets)
APP_URL=https://your-factory.up.railway.app
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER/neondb?sslmode=require
AUTH_SECRET=
OWNER_PASSWORD_HASH=
FACTORY_BRIDGE_TOKEN=
TOKEN_ENCRYPTION_KEY=

# Separate Google Drive authorization; create an OAuth Web Application client.
# Redirect: APP_URL/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Delivery worker uses the existing editor's PRIVATE artifact bucket.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
VIDEO_STORAGE_PREFIX=personal-video/v1

# Local reporter. Loads .env.local by default; never prints its token.
# FACTORY_URL defaults to APP_URL.
FACTORY_URL=
